+				    struct ath12k_per_peer_cfr_capture *params,
+				    u8 *peer_mac);
 int ath12k_cfr_send_peer_cfr_capture_cmd(struct ath12k *ar,
 					 struct ath12k_link_sta *arsta,
 					 struct ath12k_per_peer_cfr_capture *params,
@@ -114,6 +129,24 @@ static inline void ath12k_cfr_decrement_peer_count(struct ath12k *ar,
 {
 }
 
+static inline void ath12k_cfr_update_unassoc_pool_entry(struct ath12k *ar,
+							const u8 *peer_mac)
+{
+}
+
+static inline bool
+ath12k_cfr_peer_is_in_cfr_unassoc_pool(struct ath12k *ar, const u8 *peer_mac)
