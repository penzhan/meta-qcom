diff --git a/drivers/net/wireless/ath/ath12k/cfr.c b/drivers/net/wireless/ath/ath12k/cfr.c
new file mode 100644
index 000000000000..a6d1a37583a4
--- /dev/null
+++ b/drivers/net/wireless/ath/ath12k/cfr.c
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * Copyright (c) 2020-2021 The Linux Foundation. All rights reserved.
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+#include <linux/relay.h>
+#include "core.h"
+#include "debug.h"
+#include <linux/bitfield.h>
+
+static int ath12k_cfr_process_data(struct ath12k *ar,
+				   struct ath12k_dbring_data *param)
+{
+	return 0;
+}
+
+void ath12k_cfr_lut_update_paddr(struct ath12k *ar, dma_addr_t paddr,
+				 u32 buf_id)
+{
+	struct ath12k_cfr *cfr = &ar->cfr;
+
+	if (cfr->lut)
+		cfr->lut[buf_id].dbr_address = paddr;
+}
+
+static void ath12k_cfr_ring_free(struct ath12k *ar)
+{
+	struct ath12k_cfr *cfr = &ar->cfr;
+
+	ath12k_dbring_buf_cleanup(ar, &cfr->rx_ring);
+	ath12k_dbring_srng_cleanup(ar, &cfr->rx_ring);
+}
+
+static int ath12k_cfr_ring_alloc(struct ath12k *ar,
+				 struct ath12k_dbring_cap *db_cap)
+{
+	struct ath12k_cfr *cfr = &ar->cfr;
+	int ret;
+
+	ret = ath12k_dbring_srng_setup(ar, &cfr->rx_ring,
+				       ATH12K_CFR_NUM_RING_ENTRIES,
+				       db_cap->min_elem);
+	if (ret) {
+		ath12k_warn(ar->ab, "failed to setup db ring: %d\n", ret);
+		return ret;
+	}
+
+	ath12k_dbring_set_cfg(ar, &cfr->rx_ring,
+			      ATH12K_CFR_NUM_RESP_PER_EVENT,
+			      ATH12K_CFR_EVENT_TIMEOUT_MS,
+			      ath12k_cfr_process_data);
+
+	ret = ath12k_dbring_buf_setup(ar, &cfr->rx_ring, db_cap);
+	if (ret) {
+		ath12k_warn(ar->ab, "failed to setup db ring buffer: %d\n", ret);
+		goto srng_cleanup;
+	}
+
+	ret = ath12k_dbring_wmi_cfg_setup(ar, &cfr->rx_ring, WMI_DIRECT_BUF_CFR);
+	if (ret) {
+		ath12k_warn(ar->ab, "failed to setup db ring cfg: %d\n", ret);
+		goto buffer_cleanup;
+	}
+
+	return 0;
+
+buffer_cleanup:
+	ath12k_dbring_buf_cleanup(ar, &cfr->rx_ring);
+srng_cleanup:
+	ath12k_dbring_srng_cleanup(ar, &cfr->rx_ring);
+	return ret;
+}
+
+void ath12k_cfr_deinit(struct ath12k_base *ab)
+{
+	struct ath12k_cfr *cfr;
+	struct ath12k *ar;
+	int i;
+
+	if (!test_bit(WMI_TLV_SERVICE_CFR_CAPTURE_SUPPORT, ab->wmi_ab.svc_map) ||
+	    !ab->hw_params->cfr_support)
+		return;
+
+	for (i = 0; i <  ab->num_radios; i++) {
+		ar = ab->pdevs[i].ar;
+		cfr = &ar->cfr;
+
+		if (!cfr->enabled)
+			continue;
+
+		ath12k_cfr_ring_free(ar);
+
+		spin_lock_bh(&cfr->lut_lock);
+		kfree(cfr->lut);
+		cfr->lut = NULL;
+		cfr->enabled = false;
+		spin_unlock_bh(&cfr->lut_lock);
+	}
+}
+
+int ath12k_cfr_init(struct ath12k_base *ab)
+{
+	struct ath12k_dbring_cap db_cap;
+	struct ath12k_cfr *cfr;
+	u32 num_lut_entries;
+	struct ath12k *ar;
+	int i, ret;
+
+	if (!test_bit(WMI_TLV_SERVICE_CFR_CAPTURE_SUPPORT, ab->wmi_ab.svc_map) ||
+	    !ab->hw_params->cfr_support)
+		return 0;
+
+	for (i = 0; i < ab->num_radios; i++) {
+		ar = ab->pdevs[i].ar;
+		cfr = &ar->cfr;
+
+		ret = ath12k_dbring_get_cap(ar->ab, ar->pdev_idx,
+					    WMI_DIRECT_BUF_CFR, &db_cap);
+
+		if (ret)
+			continue;
+
+		idr_init(&cfr->rx_ring.bufs_idr);
+		spin_lock_init(&cfr->rx_ring.idr_lock);
+		spin_lock_init(&cfr->lock);
+		spin_lock_init(&cfr->lut_lock);
+
+		num_lut_entries = min_t(u32, CFR_MAX_LUT_ENTRIES, db_cap.min_elem);
+		cfr->lut = kzalloc_objs(*cfr->lut, num_lut_entries, GFP_KERNEL);
+		if (!cfr->lut) {
+			ret = -ENOMEM;
+			goto err;
+		}
+
+		ret = ath12k_cfr_ring_alloc(ar, &db_cap);
+		if (ret) {
+			ath12k_warn(ab, "failed to init cfr ring for pdev %d: %d\n",
+				    i, ret);
+			spin_lock_bh(&cfr->lut_lock);
+			kfree(cfr->lut);
+			cfr->lut = NULL;
+			cfr->enabled = false;
+			spin_unlock_bh(&cfr->lut_lock);
+			goto err;
+		}
+
+		cfr->lut_num = num_lut_entries;
+		cfr->enabled = true;
+
+	}
+
+	return 0;
+
+err:
+	for (i = i - 1; i >= 0; i--) {
+		ar = ab->pdevs[i].ar;
+		cfr = &ar->cfr;
+
+		if (!cfr->enabled)
+			continue;
+
+		ath12k_cfr_ring_free(ar);
+
+		spin_lock_bh(&cfr->lut_lock);
+		kfree(cfr->lut);
+		cfr->lut = NULL;
+		cfr->enabled = false;
+		spin_unlock_bh(&cfr->lut_lock);
+	}
+	return ret;
+}
diff --git a/drivers/net/wireless/ath/ath12k/cfr.h b/drivers/net/wireless/ath/ath12k/cfr.h
new file mode 100644
index 000000000000..04dc80e40887
--- /dev/null
+++ b/drivers/net/wireless/ath/ath12k/cfr.h
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/*
+ * Copyright (c) 2020-2021 The Linux Foundation. All rights reserved.
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+#ifndef ATH12K_CFR_H
+#define ATH12K_CFR_H
+
+#include "dbring.h"
+#include "wmi.h"
+
+#define ATH12K_CFR_NUM_RESP_PER_EVENT   1
+#define ATH12K_CFR_EVENT_TIMEOUT_MS     1
+#define ATH12K_CFR_NUM_RING_ENTRIES     1
+
+
+struct ath12k_cfr_dma_hdr {
+	u16 info0;
+	u16 info1;
+	u16 sw_peer_id;
+	u16 phy_ppdu_id;
+};
+
+struct ath12k_look_up_table {
+	bool dbr_recv;
+	bool tx_recv;
+	u8 *data;
+	u32 data_len;
+	u16 dbr_ppdu_id;
+	u16 tx_ppdu_id;
+	dma_addr_t dbr_address;
+	struct ath12k_csi_cfr_header header;
+	struct ath12k_cfr_dma_hdr hdr;
+	u64 txrx_tstamp;
+	u64 dbr_tstamp;
+	u32 header_length;
+	u32 payload_length;
+	struct ath12k_dbring_element *buff;
+};
+
+struct ath12k_cfr {
+	struct ath12k_dbring rx_ring;
+	/* Protect cfr data */
+	spinlock_t lock;
+	/* Protect for lut entries */
+	spinlock_t lut_lock;
+	struct ath12k_look_up_table *lut;
+	u32 lut_num;
+	u64 tx_evt_cnt;
+	u64 dbr_evt_cnt;
+	u64 release_cnt;
+	u64 tx_peer_status_cfr_fail;
+	u64 tx_evt_status_cfr_fail;
+	u64 tx_dbr_lookup_fail;
+	u64 last_success_tstamp;
+	u64 flush_dbr_cnt;
+	u64 clear_txrx_event;
+	u64 cfr_dma_aborts;
+	bool enabled;
+};
+
+#ifdef CONFIG_ATH12K_CFR
+int ath12k_cfr_init(struct ath12k_base *ab);
+void ath12k_cfr_deinit(struct ath12k_base *ab);
+void ath12k_cfr_lut_update_paddr(struct ath12k *ar, dma_addr_t paddr,
+				 u32 buf_id);
+#else
+static inline int ath12k_cfr_init(struct ath12k_base *ab)
+{
+	return 0;
+}
+
+static inline void ath12k_cfr_deinit(struct ath12k_base *ab)
+{
+}
+
+static inline void ath12k_cfr_lut_update_paddr(struct ath12k *ar,
+					       dma_addr_t paddr, u32 buf_id)
+{
+}
+#endif /* CONFIG_ATH12K_CFR */
+#endif /* ATH12K_CFR_H */
