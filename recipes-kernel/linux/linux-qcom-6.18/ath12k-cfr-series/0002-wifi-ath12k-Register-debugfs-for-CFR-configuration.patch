 	u64 tx_evt_cnt;
 	u64 dbr_evt_cnt;
@@ -60,11 +69,31 @@ struct ath12k_cfr {
 	bool enabled;
 };
 
+enum ath12k_cfr_capture_method {
+	ATH12K_CFR_CAPTURE_METHOD_NULL_FRAME,
+	ATH12K_CFR_CAPTURE_METHOD_NULL_FRAME_WITH_PHASE,
+	ATH12K_CFR_CAPTURE_METHOD_PROBE_RESP,
+	ATH12K_CFR_CAPTURE_METHOD_MAX,
+};
+
+enum ath12k_cfr_capture_bw {
+	ATH12K_CFR_CAPTURE_BW_20,
+	ATH12K_CFR_CAPTURE_BW_40,
+	ATH12K_CFR_CAPTURE_BW_80,
+	ATH12K_CFR_CAPTURE_BW_MAX,
+};
+
 #ifdef CONFIG_ATH12K_CFR
 int ath12k_cfr_init(struct ath12k_base *ab);
 void ath12k_cfr_deinit(struct ath12k_base *ab);
 void ath12k_cfr_lut_update_paddr(struct ath12k *ar, dma_addr_t paddr,
 				 u32 buf_id);
+void ath12k_cfr_decrement_peer_count(struct ath12k *ar,
+				     struct ath12k_link_sta *arsta);
+int ath12k_cfr_send_peer_cfr_capture_cmd(struct ath12k *ar,
+					 struct ath12k_link_sta *arsta,
+					 struct ath12k_per_peer_cfr_capture *params,
+					 const u8 *peer_mac);
 #else
 static inline int ath12k_cfr_init(struct ath12k_base *ab)
 {
@@ -79,5 +108,19 @@ static inline void ath12k_cfr_lut_update_paddr(struct ath12k *ar,
 					       dma_addr_t paddr, u32 buf_id)
 {
 }
+
+static inline void ath12k_cfr_decrement_peer_count(struct ath12k *ar,
+						   struct ath12k_link_sta *arsta)
+{
+}
+
+static inline int
+ath12k_cfr_send_peer_cfr_capture_cmd(struct ath12k *ar,
+				     struct ath12k_link_sta *arsta,
+				     struct ath12k_per_peer_cfr_capture *params,
+				     const u8 *peer_mac)
+{
+	return 0;
+}
 #endif /* CONFIG_ATH12K_CFR */
