@@ -345,6 +492,7 @@ ath12k_cfr_method_to_fw_cfr_method(enum ath12k_cfr_capture_method method)
 		return WMI_CFR_CAPTURE_METHOD_PROBE_RESP;
 	default:
 		return WMI_CFR_CAPTURE_METHOD_MAX;
