index 0000000000000000000000000000000000000000..46f2c3fb48497b8e96f73806f429bdf2406b8fa9
--- /dev/null
+++ b/drivers/net/wireless/ath/ath12k/cfr.h
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/*
+ * Copyright (c) 2020-2021 The Linux Foundation. All rights reserved.
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+#ifndef ATH12K_CFR_H
+#define ATH12K_CFR_H
+
+#include "dbring.h"
+#include "wmi.h"
+
+struct ath12k_base;
+struct ath12k;
+
+#define ATH12K_CFR_NUM_RESP_PER_EVENT   1
+#define ATH12K_CFR_EVENT_TIMEOUT_MS     1
+#define ATH12K_CFR_NUM_RING_ENTRIES     1
+
+struct ath12k_cfr_dma_hdr {
+	u16 info0;
+	u16 info1;
+	u16 sw_peer_id;
+	u16 phy_ppdu_id;
+};
+
+struct ath12k_look_up_table {
+	bool dbr_recv;
+	bool tx_recv;
+	u8 *data;
+	u32 data_len;
+	u16 dbr_ppdu_id;
+	u16 tx_ppdu_id;
+	dma_addr_t dbr_address;
+	struct ath12k_csi_cfr_header header;
+	struct ath12k_cfr_dma_hdr hdr;
+	u64 txrx_tstamp;
+	u64 dbr_tstamp;
+	u32 header_length;
+	u32 payload_length;
+	struct ath12k_dbring_element *buff;
+};
+
+struct ath12k_cfr {
+	struct ath12k_dbring rx_ring;
+	/* Protect cfr data */
+	spinlock_t lock;
+	/* Protect for lut entries */
+	spinlock_t lut_lock;
+	struct ath12k_look_up_table *lut;
+	u32 lut_num;
+	u64 tx_evt_cnt;
+	u64 dbr_evt_cnt;
+	u64 release_cnt;
+	u64 tx_peer_status_cfr_fail;
+	u64 tx_evt_status_cfr_fail;
+	u64 tx_dbr_lookup_fail;
+	u64 last_success_tstamp;
+	u64 flush_dbr_cnt;
+	u64 clear_txrx_event;
+	u64 cfr_dma_aborts;
+	bool enabled;
+};
+
+#ifdef CONFIG_ATH12K_CFR
+int ath12k_cfr_init(struct ath12k_base *ab);
+void ath12k_cfr_deinit(struct ath12k_base *ab);
+void ath12k_cfr_lut_update_paddr(struct ath12k *ar, dma_addr_t paddr,
+				 u32 buf_id);
+#else
+static inline int ath12k_cfr_init(struct ath12k_base *ab)
+{
+	return 0;
+}
+
+static inline void ath12k_cfr_deinit(struct ath12k_base *ab)
+{
+}
+
+static inline void ath12k_cfr_lut_update_paddr(struct ath12k *ar,
+					       dma_addr_t paddr, u32 buf_id)
+{
+}
+#endif /* CONFIG_ATH12K_CFR */
+#endif /* ATH12K_CFR_H */
